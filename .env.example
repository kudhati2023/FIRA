# FIRA Environment Configuration Example

# Database configuration
POSTGRES_USER=fira_user
POSTGRES_PASSWORD=fira_password_secure_123
POSTGRES_DB=fira_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://fira_user:fira_password_secure_123@postgres:5432/fira_db

# Cache / Queue configuration
REDIS_URL=redis://redis:6379/0

# Object Storage (MinIO) configuration
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password_secure_123
MINIO_BUCKET=fira-documents

# Security
JWT_SECRET=super_secret_jwt_signing_key_change_me_in_production_12345
MFA_ENCRYPTION_KEY=super_secret_mfa_encryption_key_change_me_32bytes_!!
SESSION_EXPIRE_MINUTES=60

# Tenant configurations
DEFAULT_RETENTION_MONTHS=24
